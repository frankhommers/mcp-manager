<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:McpManager.ViewModels"
             xmlns:sys="using:System"
             x:Class="McpManager.Views.MatrixView"
             x:DataType="vm:MatrixViewModel">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
      <TextBox Text="{Binding ServerFilter}" PlaceholderText="Filter servers" AutomationProperties.Name="Filter servers" />
      <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Text="Project" VerticalAlignment="Center" Opacity="0.75" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}"
                  SelectedItem="{Binding SelectedChoice}" AutomationProperties.Name="Project">
          <ComboBox.Styles>
            <Style Selector="ComboBoxItem" x:DataType="vm:ProjectChoiceViewModel">
              <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            </Style>
          </ComboBox.Styles>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectChoiceViewModel">
              <Panel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="Kind" Converter="{x:Static ObjectConverters.NotEqual}"
                               ConverterParameter="{x:Static vm:ProjectChoiceKind.Header}" />
                      <Binding Path="Kind" Converter="{x:Static ObjectConverters.NotEqual}"
                               ConverterParameter="{x:Static vm:ProjectChoiceKind.OtherFolder}" />
                    </MultiBinding>
                  </StackPanel.IsVisible>
                  <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Path}" Opacity="0.5" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <ItemsControl ItemsSource="{Binding Chips}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="9" Opacity="0.6" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Text="{Binding Header}" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.6"
                           Opacity="0.6"
                           IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ProjectChoiceKind.Header}}" />
                <TextBlock Text="{Binding Header}" FontStyle="Italic"
                           IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ProjectChoiceKind.OtherFolder}}" />
              </Panel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Width="28" Height="28" Padding="0" Content="↻"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Look for changes on disk" AutomationProperties.Name="Look for changes on disk"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RefreshDiskCommand}" />
      </Grid>
    </Grid>
      <Grid ColumnDefinitions="220,*">
        <StackPanel Spacing="0">
          <Border Height="72" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MatrixRowViewModel">
                <Button Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="4,0"
                        Content="{Binding Label}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectServerCommand}"
                        CommandParameter="{Binding Server}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Height="28" Padding="4,10,0,0" IsVisible="{Binding HasUnknownRows}"
                     Text="Found in your configs, not in your library" FontSize="11" FontWeight="SemiBold"
                     Opacity="0.75" TextTrimming="CharacterEllipsis" />
          <ItemsControl ItemsSource="{Binding UnknownRows}" IsVisible="{Binding HasUnknownRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UnknownServerRowViewModel">
                <TextBlock Width="220" Height="36" Padding="4,0" Text="{Binding Name}" Opacity="0.75"
                           VerticalAlignment="Center" LineHeight="36" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Spacing="0">
            <ItemsControl ItemsSource="{Binding Columns}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaceColumnViewModel">
                  <Button Width="96" Height="72" Padding="2" Background="Transparent" BorderThickness="0"
                          HorizontalContentAlignment="Center"
                          ToolTip.Tip="{Binding ToolTipText}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenTargetCommand}"
                          CommandParameter="{Binding Place}">
                    <StackPanel Spacing="1" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding GroupLabel}"
                                 FontSize="9" Opacity="0.5" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold"
                                 TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                 TextAlignment="Center" MaxWidth="92" HorizontalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Chips}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="8" Opacity="0.6" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Ellipse Width="7" Height="7" Fill="Orange" IsVisible="{Binding ShowStatusDot}" />
                        <Ellipse Width="7" Height="7" Stroke="Gray" StrokeThickness="1" IsVisible="{Binding ShowHollowDot}" />
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MatrixRowViewModel">
                  <ItemsControl ItemsSource="{Binding Cells}" Height="36">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MatrixCellViewModel">
                        <Panel Width="96">
                          <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                    IsChecked="{Binding Selection.IsEnabled}"
                                    IsEnabled="{Binding Selection.ServerId, Converter={x:Static vm:MatrixCellEnabledConverter.Instance}}" />
                          <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,22,0"
                                  Padding="3" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                                  IsVisible="{Binding NeedsChoice}"
                                  ToolTip.Tip="Differs from your library — click to choose"
                                  AutomationProperties.Name="Differs from your library — click to choose"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ResolveDifferenceCommand}"
                                  CommandParameter="{Binding}">
                            <Ellipse Width="8" Height="8" Fill="Orange" />
                          </Button>
                          <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,22,0"
                                  Padding="3" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                                  IsVisible="{Binding IsUpdatedOnDeploy}"
                                  ToolTip.Tip="Your library version replaces this on deploy — click to compare"
                                  AutomationProperties.Name="Your library version replaces this on deploy — click to compare"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ResolveDifferenceCommand}"
                                  CommandParameter="{Binding}">
                            <Ellipse Width="8" Height="8" Stroke="Gray" StrokeThickness="1.5" />
                          </Button>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="28" IsVisible="{Binding HasUnknownRows}" />
            <ItemsControl ItemsSource="{Binding UnknownRows}" IsVisible="{Binding HasUnknownRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UnknownServerRowViewModel">
                  <StackPanel Orientation="Horizontal" Height="36">
                    <ItemsControl ItemsSource="{Binding FoundIn}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:Boolean">
                          <Panel Width="96">
                            <Ellipse Width="7" Height="7" Fill="Gray" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" IsVisible="{Binding}" />
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Library" VerticalAlignment="Center" Padding="8,2" FontSize="12"
                            ToolTip.Tip="Add this server to your library"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddUnknownToLibraryCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
  </StackPanel>
</UserControl>
