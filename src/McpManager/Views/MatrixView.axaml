<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:McpManager.ViewModels"
             x:Class="McpManager.Views.MatrixView"
             x:DataType="vm:MatrixViewModel">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
      <TextBox Text="{Binding ServerFilter}" Watermark="Filter servers" AutomationProperties.Name="Filter servers" />
      <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasProjects}">
        <TextBlock Text="Project" VerticalAlignment="Center" Opacity="0.75" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Projects}"
                  SelectedItem="{Binding SelectedProject}" AutomationProperties.Name="Project">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PlaceColumnViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Place.Path}" Opacity="0.5" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Grid>
      <Grid ColumnDefinitions="220,*">
        <StackPanel Spacing="0">
          <Border Height="72" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MatrixRowViewModel">
                <Button Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="4,0"
                        Content="{Binding Label}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectServerCommand}"
                        CommandParameter="{Binding Server}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Spacing="0">
            <ItemsControl ItemsSource="{Binding Columns}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaceColumnViewModel">
                  <Button Width="96" Height="72" Padding="2" Background="Transparent" BorderThickness="0"
                          HorizontalContentAlignment="Center"
                          ToolTip.Tip="{Binding ToolTipText}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenTargetCommand}"
                          CommandParameter="{Binding Place}">
                    <StackPanel Spacing="1" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding GroupLabel}"
                                 FontSize="9" Opacity="0.5" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold"
                                 TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                 TextAlignment="Center" MaxWidth="92" HorizontalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Chips}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="8" Opacity="0.6" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Ellipse Width="7" Height="7" Fill="Orange" IsVisible="{Binding ShowStatusDot}" />
                        <Ellipse Width="7" Height="7" Stroke="Gray" StrokeThickness="1" IsVisible="{Binding ShowHollowDot}" />
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MatrixRowViewModel">
                  <ItemsControl ItemsSource="{Binding Cells}" Height="36">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ServerSelectionViewModel">
                        <Panel Width="96">
                          <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                    IsChecked="{Binding IsEnabled}"
                                    IsEnabled="{Binding ServerId, Converter={x:Static vm:MatrixCellEnabledConverter.Instance}}" />
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
  </StackPanel>
</UserControl>
